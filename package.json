{
  "name": "pitchpass",
  "version": "0.1.0",
  "private": true,
  "description": "A beginner's guide to the English Premier League.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "seed": "npm run seed --workspace backend",
    "test": "npm test --workspace backend"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
